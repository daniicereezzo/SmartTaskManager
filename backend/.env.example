# Smart Task Manager Backend Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_task_manager
DB_USER=smarttaskmanager
DB_PASSWORD=smarttaskmanager123
DATABASE_URL=postgresql://smarttaskmanager:smarttaskmanager123@localhost:5432/smart_task_manager

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Calendar API
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info
